# Dependencies / build output
node_modules/
dist/
.vite/

# Packaged distributables (raze-ts.zip is ~280 MB)
*.zip

# esbuild bundles emitted by the smoke scripts — regenerated by `npm run smoke*`
test/_*.mjs

# Bake intermediates. Every one of these is regenerated by the tools that write
# them (tools/*/build_*.py), so they are output, not source. The baked PNGs they
# produce under public/assets ARE committed — those cannot be rebuilt without
# the 6.3 GB decompiled_swf tree, which lives outside this repo and is a
# third-party decompile we do not redistribute.
tools/*/sheets/
tools/*/sheets2/
tools/*/_verify/
tools/arm-reload/_weld.png

# Python
__pycache__/
*.py[cod]

# Local env / editor / OS
.env
.env.*
!.env.example
*.local
.DS_Store
Thumbs.db
.idea/
.vscode/
