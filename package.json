{
  "name": "raze-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript/WebGL port of the Flash game Raze (2010, Armor Games). Ported from decompiled ActionScript 3.",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.ts",
    "server:once": "node server/index.ts",
    "server:bundle": "esbuild server/index.ts --bundle --format=esm --platform=node --packages=external --outfile=dist-server/server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild test/smoketest.ts --bundle --format=esm --platform=node --alias:pixi.js=./test/pixi-stub.mjs --outfile=test/_smoke.mjs && node test/_smoke.mjs",
    "smoke:ui": "esbuild test/uismoke.ts --bundle --format=esm --platform=node --alias:pixi.js=./test/pixi-stub.mjs --outfile=test/_uismoke.mjs && node test/_uismoke.mjs",
    "smoke:layout": "esbuild test/layoutcheck.ts --bundle --format=esm --platform=node --alias:pixi.js=./test/pixi-stub.mjs --outfile=test/_layoutcheck.mjs && node test/_layoutcheck.mjs",
    "smoke:anim": "esbuild test/animcheck.ts --bundle --format=esm --platform=node --outfile=test/_animcheck.mjs && node test/_animcheck.mjs",
    "smoke:relay": "esbuild test/relaycheck.mjs --bundle --format=esm --platform=node --packages=external --outfile=test/_relaycheck.mjs && node test/_relaycheck.mjs",
    "smoke:camp": "esbuild test/campcheck.ts --bundle --format=esm --platform=node --alias:pixi.js=./test/pixi-stub.mjs --outfile=test/_campcheck.mjs && node test/_campcheck.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "planck": "^1.4.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
